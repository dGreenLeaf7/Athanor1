<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.diagnostics>
        <sources>
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
        </sharedListeners>
    </system.diagnostics>
  <appSettings>
    <add key="Method" value="Post"/>
   
    <add key="userName" value="devuser"/>
    <add key="password" value="REDACTED"/>
    <add key="getFileListURI" value="https://flt.contoso.example/export/autoGetFileList.aspx"/>
    <add key="createFileURI" value="https://flt.contoso.example/export/autoCreateFile.aspx"/>
    <add key="fetchFileURI" value="https://flt.contoso.example/export/autoFetchFile.aspx"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup></configuration>
