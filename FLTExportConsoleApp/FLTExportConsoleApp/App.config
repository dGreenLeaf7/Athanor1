<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
  <appSettings>
    <add key="NbrOfDaysHistory" value="3" />
    <add key="DownloadPath" value="C:\Users\devuser\Git Repos\VS2017\FLT\FLTExportConsoleApp\exports" />
    <add key="ContosoLoggerEnableLogging" value="true" />
    <add key="ContosoLoggerIsWriteEventLog" value="false" />
    <add key="ContosoLoggerIsWriteDatabase" value="false" />
    <add key="ContosoLoggerIsWriteTextFile" value="true" />
    <add key="ContosoLoggerTextFilePath" value="C:\Users\devuser\Git Repos\VS2017\FLT\FLTExportConsoleApp\logs\FLTExport.log" />
    <add key="ContosoLoggerAppName" value="FLTExport" />
  </appSettings>
  <connectionStrings>
    <add name="FLT" connectionString="Data Source=dbserver02;Initial Catalog=FLT;Persist Security Info=True; Integrated Security=SSPI;pooling='true';Min Pool Size=5;Max Pool Size=600;Connect Timeout=600;" />
  </connectionStrings>
  <runtime>
