<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <httpCookies httpOnlyCookies="true" requireSSL="true" xdt:Transform="Insert"/>
    <authentication mode="Forms" xdt:Transform="Replace">
      <forms loginUrl="Login.aspx" timeout="60" requireSSL="true" cookieless="UseCookies" />
    </authentication>
    <sessionState mode="InProc" cookieless="false" timeout="5" sessionIDManagerType="NWebsec.SessionSecurity.SessionState.AuthenticatedSessionIDManager, NWebsec.SessionSecurity, Version=1.0.0.0, Culture=neutral, PublicKeyToken=3613da5f958908a1" xdt:Transform="Replace" />
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>