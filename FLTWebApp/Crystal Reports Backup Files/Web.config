<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="nwebsec">
      <section name="sessionSecurity" type="NWebsec.SessionSecurity.Configuration.SessionSecurityConfigurationSection, NWebsec.SessionSecurity, Version=1.0.0.0, Culture=neutral, PublicKeyToken=3613da5f958908a1" requirePermission="false" allowDefinition="MachineToApplication" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="FLT" connectionString="Data Source=dbserver03;Initial Catalog=FLT;Persist Security Info=True;User ID=IUSR_FLT;Password=REDACTED;pooling='true';Min Pool Size=5;Max Pool Size=600;Connect Timeout=600;" />
    <add name="FLTReport" connectionString="Data Source=dbserver03;Initial Catalog=FLT;Persist Security Info=True;User ID=IUSR_FLT;Password=REDACTED;Min Pool Size=5;Max Pool Size=60;Connect Timeout=360;" />
  </connectionStrings>

  <system.web>
    <httpRuntime maxRequestLength="10000" executionTimeout="10000" encoderType="Microsoft.Security.Application.AntiXssEncoder, AntiXssLibrary" />

    <compilation debug="true" strict="true" explicit="true" targetFramework="4.5">
      <assemblies>
        <add assembly="CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
        <add assembly="CrystalDecisions.Shared, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
        <add assembly="CrystalDecisions.ReportSource, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
        <add assembly="CrystalDecisions.CrystalReports.Engine, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
        <add assembly="CrystalDecisions.ReportAppServer.ClientDoc, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
      </assemblies>
    </compilation>
    <pages viewStateEncryptionMode="Auto" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <namespaces>
        <clear />
        <add namespace="System" />
        <add namespace="System.Collections" />
        <add namespace="System.Collections.Specialized" />
        <add namespace="System.Configuration" />
        <add namespace="System.Text" />
        <add namespace="System.Text.RegularExpressions" />
        <add namespace="System.Web" />
        <add namespace="System.Web.Caching" />
        <add namespace="System.Web.SessionState" />
        <add namespace="System.Web.Security" />
        <add namespace="System.Web.Profile" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="System.Web.UI.WebControls.WebParts" />
        <add namespace="System.Web.UI.HtmlControls" />
      </namespaces>
    </pages>
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" timeout="30" />
    </authentication>
    <sessionState mode="InProc" cookieless="false" timeout="30" sessionIDManagerType="NWebsec.SessionSecurity.SessionState.AuthenticatedSessionIDManager, NWebsec.SessionSecurity, Version=1.0.0.0, Culture=neutral, PublicKeyToken=3613da5f958908a1" />

    <httpHandlers>
      <add verb="GET" path="CrystalImageHandler.aspx" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
    </httpHandlers>
  </system.web>
  <location allowOverride="true" inheritInChildApplications="true">
    <appSettings>
      <add key="BatchLoginMode" value="Both" />
      <add key="appTitle" value="Contoso Flight Log Tracking" />
      <add key="FileBufferSize" value="4096" />
      <add key="MaxFileUploadSize" value="10000000" />

      <add key="ContosoLoggerEnableLogging" value="true" />
      <add key="ContosoLoggerIsWriteEventLog" value="false" />
      <add key="ContosoLoggerIsWriteDatabase" value="false" />
      <add key="ContosoLoggerIsWriteTextFile" value="true" />
      <add key="ContosoLoggerTextFilePath" value="C:\Users\devuser\Documents\Visual Studio 2013\Projects\FLT\FLTWebApp\logs\flt.log" />
      <add key="ContosoLoggerAppName" value="FLT" />
      <add key="WebmasterEmailAddress" value="dev.user@contoso.example" />
      <add key="SMTPServer" value="MAILSERVER01.CONTOSONET.EXAMPLE" />
      <add key="SysName" value="Contoso Flight Log Tracking" />
      <add key="LoginURL" value="http://flt.contoso.example" />
      <add key="appPrefix" value="FLT" />
      <add key="ReportDBServerName" value="dbserver03" />
      <add key="ReportDBName" value="FLT" />
      <add key="ReportUserId" value="IUSR_FLT" />
      <add key="ReportPassword" value="REDACTED" />
      <add key="CrystalImageCleaner-AutoStart" value="true" />
      <add key="CrystalImageCleaner-Sleep" value="60000" />
      <add key="CrystalImageCleaner-Age" value="120000" />
      <add key="LockoutDuration" value="10" />
      <add key="MaximumLoginFailuresAllowed" value="5" />

    </appSettings>
  </location>
  <system.webServer>
    <handlers>
      <add name="CrystalImageHandler.aspx_GET" verb="GET" path="CrystalImageHandler.aspx" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.2000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" preCondition="integratedMode" />
    </handlers>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="NWebsecConfig" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
  <nwebsec>
    <sessionSecurity xmlns="http://nwebsec.com/SessionSecurityConfig.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="NWebsecConfig/SessionSecurityConfig.xsd">
    </sessionSecurity>
  </nwebsec>
</configuration>