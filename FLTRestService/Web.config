<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="FLT" connectionString="Data Source=dbserver05\sql2k5;Initial Catalog=FLT;Persist Security Info=True;User ID=IUSR_FLT;Password=REDACTED;Min Pool Size=5;Max Pool Size=60;Connect Timeout=360;"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.0"/>
    <caching>
      <outputCache enableOutputCache="true"/>
      <outputCacheSettings>
        <outputCacheProfiles>
          <add name="ProgramList" location="Server" duration="60" varyByParam="skip; top; manager" varyByHeader="Accept"/>
        </outputCacheProfiles>
      </outputCacheSettings>
    </caching>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
  <location allowOverride="true">
    <appSettings>
      
      <add key="userName" value="test"/>
      <add key="password" value="REDACTED" />
      
      <add key="BatchLoginMode" value="Both"/>
      <add key="appTitle" value="Contoso Flight Log Tracking"/>
      <add key="FileBufferSize" value="4096"/>
      <add key="MaxFileUploadSize" value="10000000"/>
      <add key="ContosoLoggerEnableLogging" value="true"/>
      <add key="ContosoLoggerIsWriteEventLog" value="false"/>
      <add key="ContosoLoggerIsWriteDatabase" value="false"/>
      <add key="ContosoLoggerIsWriteTextFile" value="true"/>
      <add key="ContosoLoggerTextFilePath" value="c:\Documents and Settings\devuser\My Documents\Visual Studio 2010\Projects\FltRestService\FltRestService\logs\flt.log"/>
      <add key="ContosoLoggerAppName" value="FLTWebService"/>
      <add key="WebmasterEmailAddress" value="dev.user@contoso.example"/>
      <add key="SMTPServer" value="MAILSERVER02.CONTOSONET.EXAMPLE"/>
      <add key="SysName" value="Contoso Flight Log Tracking"/>
      <add key="LoginURL" value="http://flt.contoso.example"/>
      <add key="appPrefix" value="FLT"/>
      <add key="LockoutDuration" value="10"/>
      <add key="MaximumLoginFailuresAllowed" value="5"/>
    </appSettings>
  </location>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
  </system.webServer>
  <system.serviceModel>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true"/>
    <standardEndpoints>
      <webHttpEndpoint>
        <standardEndpoint name="" helpEnabled="true" automaticFormatSelectionEnabled="true"/>
      </webHttpEndpoint>
    </standardEndpoints>
  </system.serviceModel>
</configuration>